{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QNFO runbook manifest payload (mode_B: step-tree + prose)",
  "type": "object",
  "required": [
    "title",
    "steps",
    "prose"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "what"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.-]+$"
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "connector": {
            "type": "string",
            "enum": [
              "PROOF",
              "BY"
            ]
          },
          "substeps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "what"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "prose": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}