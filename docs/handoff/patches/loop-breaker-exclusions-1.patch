+}
+
+// 15. the detector: reads 0 on the new view, non-zero on the old view and on a view that only mentions the table
+{
+  const probeOf = (db) => (db.prepare("SELECT verify_probe FROM remediation_contracts WHERE class = 'fm-loop-breaker-ignores-exclusions'").get() || {}).verify_probe || "";
+  const run = (db, p) => (p ? db.prepare(p).get() : null);
+  const db = build(true, seedAll);
+  const p = probeOf(db);
+  ok(p.length > 100, "the detector probe exists", p.length);
+  // the remediation consumer's gate (scripts/remediation_consumer.py is_literal_select): one literal read-only SELECT
+  const WRITE_KW = ["insert into", "update ", "delete from", "drop table", "drop index", "alter table", "create table", "create index", "create trigger", "attach ", "detach ", "pragma ", "replace into", "vacuum"];
+  ok(/^select/i.test(p.trim()) && !p.includes(";") && WRITE_KW.every((k) => !p.toLowerCase().includes(k)), "the probe passes the consumer's literal-SELECT gate");
+  ok(!/\bLIKE\b/i.test(p), "the probe has no LIKE pattern (D1 caps a LIKE pattern at 50 bytes)");
+  const good = run(db, p);
+  ok(good && good.expected === "0" && good.observed === "0", "new view: observed 0 although unclassified qnfo-ops, error-capture-tick and other-job signatures are listed", good);
+  ok(rows(db).length === 5, "(the unclassified signatures are listed while the detector reads 0)");
+  // regression 1: the view is recreated without the join (a later migration copying the 2026-10-09 text)
+  db.exec("DROP VIEW v_loop_breaker_signatures");
+  db.exec(OLD_VIEW);
+  const bad = run(db, p);
