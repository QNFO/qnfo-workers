+const NO_COL = "D1_ERROR: no such column: ts at offset 11: SQLITE_ERROR";
+
+// the rows behind the four issues, as read from cloud_ops_events on 2026-10-19 (6 + 4 + 4 + 4 in 24 h)
+function liveRows(db) {
+  many(db, 6, { text: "shell_exec", meta: cutMeta(CMD_EXIT_QW) });
