+  // regression 2: the table is only mentioned
+  db.exec("DROP VIEW v_loop_breaker_signatures");
+  db.exec(OLD_VIEW.replace("CREATE VIEW v_loop_breaker_signatures AS", "CREATE VIEW v_loop_breaker_signatures AS /* tool_error_exclusions */"));
+  const decoy = run(db, p);
+  ok(decoy && decoy.observed !== "0" && Number(decoy.observed) >= 3, "a view that only names the table still reads non-zero (the listed signatures match patterns)", decoy);
+  // the base database has no detector: nothing to run
+  ok(probeOf(build(false, seedAll)) === "", "the base has no detector contract");
+}
+
+console.log(`loop-breaker-exclusions: ${pass} passed, ${fail} failed`);
+process.exit(fail ? 1 : 0);
