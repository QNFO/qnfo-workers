+  many(db, 3, { kind: "error-capture-tick", job: "qnfo-ops", text: "error capture: http 200, 22 error event(s) in 35 min, 16 new worker_logs row(s) across 6 worker(s); write: D1_ERROR: Network connection lost.", meta: "{\"ran\":true}" });
+}
+
+const SIGS = {
+  cut: ["qnfo-ops", "shell_exec"],
+  cmd: ["qnfo-ops", sigOf("shell_exec", CMD_EXIT)],
+  cwe: ["qnfo-ops", sigOf("container_workspace_exec", CMD_EXIT_QW)],
+  col: ["qnfo-ops", sigOf("ops_d1_query", NO_COL)],
+  timeout: ["qnfo-ops", sigOf("container_workspace_exec", "container timeout after 60000 ms")],
+  gh404: ["qnfo-ops", "github_file_write"],
+  auth: ["qnfo-ops", sigOf("ops_d1_query", "D1_ERROR: not authorized: SQLITE_AUTH")],
+  codeFail: ["qnfo-code-orchestrator", sigOf("ct_im100025 read: read failed: repo name refused for raw read (HTTP 400)", "")],
+  tick: ["qnfo-ops", sigOf("error capture: http 200, 22 error event(s) in 35 min, 16 new worker_logs row(s) across 6 worker(s); write: D1_ERROR: Network connection lost.", "")],
+};
+ok(SIGS.cmd[1] === "shell_exec: command exited : bash: line : cd: /w" && SIGS.cwe[1] === "container_workspace_exec: command exited : bash:" && SIGS.col[1] === "ops_d_query: D_ERROR: no such column: ts at offs",
+  "the fixture signatures are the live ones of issues 100083, 100127 and 100128", SIGS);
+
+function build(migrate, seed) {
+  const db = new DatabaseSync(":memory:");
+  db.exec(DDL);
+  const ins = db.prepare("INSERT INTO tool_error_exclusions (pattern, err_class, rationale) VALUES (?, ?, 'live row')");
+  for (const [p, c] of EXCLUSIONS) ins.run(p, c);
+  db.prepare("INSERT INTO control_registry (control, location, kind, guards_against, critical_path, disposition, disposition_state, alternate_path, evidence, issue_id) VALUES ('tool_error_exclusions', ?, 'filter', 'TOOL-FAILURE issues filed for caller-input errors no tool change can fix', 0, 'keep', 'applied', 'tool_failures_excluded_24h', 'RESOLVE-ALL-OPEN-1', 2799)").run(TOOL_EXCLUSIONS_LOCATION);
+  db.exec(OLD_VIEW);
+  if (seed) seed(db);
+  if (migrate) db.exec(sql);
+  return db;
+}
+const rows = (db) => db.prepare("SELECT src, producer, sig, n, last_ts, example FROM v_loop_breaker_signatures ORDER BY src, producer, sig").all();
+const has = (rs, [producer, sig]) => rs.find((r) => r.producer === producer && r.sig === sig);
+const seedAll = (db) => { liveRows(db); genuineRows(db); };
+
+// 1. the base shows the defect: the four signatures of the four issues are listed
+{
+  const base = rows(build(false, seedAll));
+  ok(has(base, SIGS.cut)?.n === 6, "base: (qnfo-ops, shell_exec) n=6 (issue 100079)", base.map((r) => [r.producer, r.sig, r.n]));
+  ok(has(base, SIGS.cmd)?.n === 4, "base: shell_exec command exited n=4 (issue 100083)");
+  ok(has(base, SIGS.cwe)?.n === 4, "base: container_workspace_exec command exited n=4 (issue 100127)");
+  ok(has(base, SIGS.col)?.n === 4, "base: ops_d1_query no such column n=4 (issue 100128)");
+}
+
+// 2. after the file: the four are gone; everything no exclusion classifies stays
+{
+  const after = rows(build(true, seedAll));
+  ok(!has(after, SIGS.cut), "after: (qnfo-ops, shell_exec) of the cut meta rows is gone (issue 100079)", after.map((r) => [r.producer, r.sig, r.n]));
+  ok(!has(after, SIGS.cmd), "after: shell_exec command exited is gone (issue 100083)");
+  ok(!has(after, SIGS.cwe), "after: container_workspace_exec command exited is gone (issue 100127)");
+  ok(!has(after, SIGS.col), "after: ops_d1_query no such column is gone (issue 100128)");
+  ok(has(after, SIGS.timeout)?.n === 3, "after: a container timeout (no exclusion pattern) is still listed", has(after, SIGS.timeout));
+  ok(has(after, SIGS.gh404)?.n === 3, "after: a cut github_file_write 404 (no exclusion pattern) is still listed");
+  ok(has(after, SIGS.auth)?.n === 3, "after: an ops_d1_query SQLITE_AUTH error is still listed");
+  ok(has(after, SIGS.codeFail)?.n === 3, "after: a code-task.fail row with 'HTTP 4' in its text is still listed (the filter is scoped to ops_ai_tool)");
+  ok(has(after, SIGS.tick)?.n === 3, "after: a qnfo-ops error-capture-tick row is still listed (same job, other kind)");
+  ok(after.length === 5, "after: exactly the five unclassified signatures remain", after.map((r) => [r.producer, r.sig]));
