+  // decision_predictions_parse (D1 trigger) turns ' within ' in predicted_outcome into a scored metric prediction; this one is not a metric
+  ok(d && !d.predicted_outcome.includes(" within "), "the prediction text has no ' within ' for the metric-prediction parser");
+  for (const t of ["failure_modes", "decision_log", "control_registry", "remediation_contracts"])
+    ok(!/#\d/.test(JSON.stringify(db.prepare("SELECT * FROM " + t).all())), t + ": no bare issue-number reference in the text written");
+}
+
+// 13. the Rollback line restores the live view and removes what the file added
+{
+  const hdr = sql.split("\n").find((l) => /^--\s*Rollback:/i.test(l)) || "";
+  const rb = hdr.replace(/^--\s*Rollback:\s*/i, "");
+  ok(rb.length > 1443, "the file has a one-line Rollback with SQL", hdr.length);
+  const view = rb.split("; ").find((s) => s.startsWith("CREATE VIEW v_loop_breaker_signatures")) || "";
+  ok(view === OLD_VIEW, "the Rollback line holds the exact live view text", view.length);
