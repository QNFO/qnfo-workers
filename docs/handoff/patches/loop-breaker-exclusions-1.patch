+  ok(count("remediation_contracts", "class = 'fm-loop-breaker-ignores-exclusions'") === 0 && count("failure_modes", "fm_key = 'loop-breaker-ignores-exclusions'") === 0
+    && count("control_registry", "control = 'loop-breaker-tool-error-exclusions'") === 0, "the Rollback removes the detector, the failure mode and the control row");
