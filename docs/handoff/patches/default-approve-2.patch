+        AND decision = 1 AND hard = 0 AND ib = 0 AND proof = 1 AND gate = 'fleet' AND COALESCE(source, '') <> 'owner-request-issue' THEN 1 ELSE 0 END AS approve,
+  CASE WHEN COALESCE((SELECT value FROM ops_config WHERE key = 'default_approve_gate'), 'on') <> 'off' AND COALESCE((SELECT value FROM ops_config WHERE key = 'autonomy_first_gate'), 'on') <> 'off'
