{
  "name": "qnfo-artifact-agent",
  "main": "src/server.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "class_name": "ArtifactAgent", "name": "ArtifactAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["ArtifactAgent"], "tag": "v1" }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "qnfo" }],
  "vars": { "ARTIFACTS_NAMESPACE": "qnfo" }
}
