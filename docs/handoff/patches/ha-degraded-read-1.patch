+ ('fm-rum-degraded-read', NULL, 'HA-DEGRADED-READ-1', 'failure mode detector',
+  'SELECT ''0'' AS expected, CAST(CASE WHEN (SELECT CASE WHEN json_valid(meta) THEN json_extract(meta, ''$.guard'') END FROM cloud_ops_events WHERE kind IN (''human-audience'', ''human-audience-degraded'') AND ts >= strftime(''%Y-%m-%dT%H:%M:%SZ'', ''now'', ''-6 hours'') ORDER BY ts DESC LIMIT 1) IS NULL THEN 1 ELSE 0 END AS TEXT) AS observed',
+  'd1-query', 3, 'qnfo-fleet-control', 1, 'active', 'failure-mode', 45000, 5, 0);
+
+-- Re-arm the contract of the issue that is open for trigger 1820 (2607 today; the closed 2040 and the monitoring 2945 are left alone, see
+-- the contracts note above). Marker absent reads pending (a deferral: REMEDIATION-PENDING-PREFIX-1), and so does a held first read
+-- while the poisoned value is still stored, so neither can count as a failure; a real breach reads 0. The instr() marker makes a
+-- second run a no-op, and no open issue means no row is touched.
+UPDATE remediation_contracts
