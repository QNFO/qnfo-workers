+function detectEmptyAttachmentFrames(text) {
+  const frames = [];
+  const s = String(text || "");
+  const re = /<ATTACHMENT_FILE>[\s\S]*?<FILE_CONTENT>([\s\S]*?)<\/FILE_CONTENT>[\s\S]*?<\/ATTACHMENT_FILE>/g;
+  let m;
+  while ((m = re.exec(s))) {
+    const block = m[0];
+    const inner = m[1] || "";
+    if (!/^[\s\r\n\t]*$/.test(inner)) continue;
+    const pick = (tag) => {
+      const mm = block.match(new RegExp("<" + tag + ">([\\s\\S]*?)<\\/" + tag + ">"));
+      return mm ? String(mm[1] || "").trim() : null;
+    };
+    frames.push({ name: pick("FILE_NAME"), key: pick("FILE_KEY"), declared_size: pick("FILE_SIZE"), sandbox_path: pick("SANDBOX_PATH"), file_content_gap_chars: inner.length });
+  }
+  return frames;
+}
