{
  "name": "qnfo-fleet-advisor",
  "main": "src/server.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "class_name": "FleetAdvisor", "name": "FleetAdvisor" }]
  },
  "migrations": [{ "new_sqlite_classes": ["FleetAdvisor"], "tag": "v1" }],
  "d1_databases": [
    { "binding": "AUDIT_DB", "database_name": "qnfo-audit", "database_id": "35e2e573-92f3-46ac-83c6-22f6429fc5e5" }
  ],
  "routes": [
    { "pattern": "qnfo-fleet-advisor.qnfo.org", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/20 * * * *"] },
  "vars": {
    "CF_ACCOUNT_ID": "edb167b78c9fb901ea5bca3ce58ccc4b",
    "ADVISOR_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "REVIEW_MODEL": "@cf/openai/gpt-oss-120b",
    "ADVISOR_ITERS": "3",
    "PROBE_WORKERS": "qnfo-ai,qnfo-ops,qnfo-kaizen,qnfo-paper-reviser,qnfo-outreach,qnfo-research-exec,qnfo-error-selfheal,qnfo-fleet-calibrator,qnfo-auditor,qnfo-social,qnfo-intent-orchestrator,qnfo-cloud-ops,qnfo-gateway,qnfo-infra"
  }
}
