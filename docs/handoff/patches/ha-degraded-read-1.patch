+       verify_transport = 'd1-query', status = 'active', expected_cadence_h = 1, attempts = 0, last_verdict = NULL, next_due_at = datetime('now')
+ WHERE class IN (SELECT 'issue-' || id FROM agent_issues WHERE status = 'open' AND title LIKE 'METRIC-TRIGGER-1820-%')
+   AND instr(verify_probe, '$.guard') = 0;
+
+INSERT INTO decision_log (actor, assumption, action, evidence, outcome, blast_radius, rollback_path, capability_gain, predicted_outcome, surfaces_tested)
+SELECT 'session_01QpQv19uh1padRwZ3u1r766:ha-degraded-read-1',
