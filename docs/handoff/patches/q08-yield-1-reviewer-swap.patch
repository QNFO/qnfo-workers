+// ---- 8b. avoid is a preference: a fresh family first while it is healthy, then a reused working family, then the flagged ones -------------
+{
+  const av = ["moonshot", "deepseek"], glqw = { [GLM]: true, [QWEN]: true };
+  ok(R.pickPanel(["nvidia", "openai"], 2, 0, {}, av).join() === [GLM, QWEN].join(), "nothing flagged: the fresh families (glm, qwen) still lead, so the independence of a fresh panel is kept", R.pickPanel(["nvidia", "openai"], 2, 0, {}, av).map(short));
