+
+INSERT OR IGNORE INTO failure_modes (fm_key, failure_mode, root_cause, remediation, detector, probe_class, first_seen, issue_id, trigger_condition, symptom, blast_radius) VALUES
+ ('rum-degraded-read',
+  'a Web Analytics (RUM) read that succeeds with a fraction of the data is published as a number',
+  'refreshHumanAudience rejected only an error or a group-limit hit and refreshRegistryMetrics summed whatever groups came back, so a partial result (5 to 7 groups instead of 24, an empty 30-day window, a prior window with 7 of 30 days) became external 0, pageviews_30d 0, impressions growth -100 and "n/a: prior window has 7 of 30 days"; nothing compared a read with the ones before it. It recurred at 12:31Z on 2026-10-19, two hours after the first sighting',
+  'qnfo-fleet-dashboard 1.52.0 (HA-DEGRADED-READ-1): a read that is a fraction of the baseline (the newest audience row that passed the guard, or the stored value of the metric) is held, with a ledger row (human-audience-degraded, registry-rum-degraded) and no metric or series write; the hold lasts one read, the next read is accepted whatever it says; human-audience.test.mjs holds the rules',
+  'the newest cloud_ops_events row of kind human-audience or human-audience-degraded is at most 6 hours old and carries meta.guard (a newest row without the marker is a refresh that ran the pre-1.52.0 code, no row in 6 hours is a stalled refresh)',
+  'fm-rum-degraded-read', '2026-10-19', 2040,
+  'a Cloudflare GraphQL rumPageloadEventsAdaptiveGroups read that returns without an error and with part of the data (observed 2026-10-19 10:31Z and 12:31Z)',
+  'the ledger says external 0 with 5 to 7 rows against 23 to 24, impressions growth reads -100 or n/a, METRIC-TRIGGER-1820 and METRIC-TRIGGER-370 reopen, and both recover an hour later',
+  'covered: external_referred_pageviews_7d, continuation_pageviews_7d, reach_signals cf-rum-human, pageviews_30d, impressions_growth_30d and referral_30d, and every issue and strategy reading that grades them');
