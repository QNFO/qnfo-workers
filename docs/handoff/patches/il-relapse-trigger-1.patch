+  eq(st("METRIC-FIX-RELAPSED-1: gateway_cap_30d_usd"), "closed", "the open relapse issue of a trigger-clear metric is closed");
+  const gev = ev("METRIC-FIX-RELAPSED-1: gateway_cap_30d_usd");
