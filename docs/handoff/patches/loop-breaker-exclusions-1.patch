+}
+// errors no exclusion classifies, and rows of another kind
+function genuineRows(db) {
+  many(db, 3, { text: "container_workspace_exec", meta: metaOf("container timeout after 60000 ms") });
+  many(db, 3, { text: "github_file_write", meta: cutMeta("GitHub 404: Branch chatbox/cron-tick-5m not found") });
+  many(db, 3, { text: "ops_d1_query", meta: metaOf("D1_ERROR: not authorized: SQLITE_AUTH", { sql: "SELECT 1" }) });
