{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QNFO gate manifest payload",
  "type": "object",
  "required": [
    "gates"
  ],
  "properties": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Z0-9-]+$"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "superseded",
              "deprecated"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_pointer": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}