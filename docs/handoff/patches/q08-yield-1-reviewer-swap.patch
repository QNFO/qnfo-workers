+  const after = run([[Y, null, "glm", 217, 96], [Y, null, "qwen", 78, 63], [Y, null, "kimi", 148, 0], [Y, null, "dsf", 214, 1], [T, null, "glm", 9, 4], [T, null, "qwen", 3, 3], [T, null, "kimi", 120, 0], [T, null, "dsf", 150, 2]]);
