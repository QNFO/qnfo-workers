{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QNFO systems report card payload",
  "type": "object",
  "required": [
    "scored_at",
    "autonomy",
    "layers",
    "loops",
    "grade"
  ],
  "properties": {
    "scored_at": {
      "type": "string",
      "minLength": 10
    },
    "frameworks": {
      "type": "object",
      "additionalProperties": true
    },
    "autonomy": {
      "type": "object",
      "required": [
        "sae_level",
        "ladder",
        "alfus",
        "watchmaker_index"
      ],
      "properties": {
        "sae_level": {
          "type": "string",
          "minLength": 2
        },
        "sheridan_loa": {
          "type": "integer"
        },
        "ladder": {
          "type": "object",
          "additionalProperties": true
        },
        "alfus": {
          "type": "object",
          "required": [
            "human_independence",
            "mission_complexity",
            "environmental_complexity"
          ],
          "properties": {
            "human_independence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "mission_complexity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "environmental_complexity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          },
          "additionalProperties": true
        },
        "watchmaker_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "watchmaker_evidence": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "gap"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "loops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "state",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "gap"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "grade": {
      "type": "object",
      "required": [
        "letter",
        "score",
        "autonomy_band",
        "summary"
      ],
      "properties": {
        "letter": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "autonomy_band": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "objective_function": {
      "type": "string"
    }
  },
  "additionalProperties": true
}