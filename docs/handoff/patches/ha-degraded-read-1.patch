+// HA-DEGRADED-READ-1 migration suite (2026-10-19, agent_issues 2040, 2945 and 2607): applies 2026-10-19-rum-degraded-read-guard.sql to
+// node:sqlite fixtures that carry the live columns of remediation_contracts, control_registry (with its CHECKs), failure_modes,
+// agent_issues and decision_log (with the append-only triggers). Proves: the control, the failure mode and the fm- detector contract
+// are registered; the contract of the issue that is OPEN for trigger 1820 (issue-2607, superseded before) is re-armed active with the
+// guard-marker probe, while the contracts of the closed issue 2040 and of the monitoring issue 2945 (never probed: the tick selects
+// active and holding only) are left exactly as they were, and with no open issue nothing is armed; the probe reads 'pending: ...' (a
+// deferral, REMEDIATION-PENDING-PREFIX-1) until the newest audience ledger row (human-audience or human-audience-degraded) carries
+// meta.guard and while the trigger is in breach and the newest row is a held read, then 1 when the trigger is green and the series
+// holds, and 0 for a real breach, a short series, series values under the target or days that miss it; the detector judges the newest
+// ledger row only (a held read clears it), reads 1 for an unguarded newest row, for a newest row older than 6 hours or for no row at
+// all, and 0 otherwise (the ts bound has the same ISO shape as the rows); a second apply changes nothing, even after the contract moved
+// on; the Rollback header restores the re-armed contract from the backup table and removes the rows this file added (decision_log is
+// append-only and stays); the header passes scripts/apply_migrations.py --check; no skip-CI token text.
+// Run: node migrations/rum-degraded-read-guard.test.mjs
+import { DatabaseSync } from "node:sqlite";
+import { readFileSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const file = new URL("./2026-10-19-rum-degraded-read-guard.sql", import.meta.url);
+const sql = readFileSync(file, "utf8");
+let pass = 0, fail = 0;
+const ok = (c, m, d) => { if (c) pass++; else { fail++; console.log("FAIL " + m + (d === undefined ? "" : " :: " + JSON.stringify(d))); } };
+
+// The live columns (read from qnfo-audit 2026-10-19).
+const DDL = `
+CREATE TABLE remediation_contracts (class TEXT PRIMARY KEY, issue_id INTEGER, precondition TEXT NOT NULL, action TEXT NOT NULL, verify_probe TEXT NOT NULL, verify_transport TEXT NOT NULL, max_attempts INTEGER NOT NULL DEFAULT 3, escalate_to TEXT NOT NULL, expected_cadence_h INTEGER, status TEXT DEFAULT 'active', ts TEXT DEFAULT (datetime('now')), last_attempt_at TEXT, last_verdict TEXT, module TEXT, budget_ms INTEGER DEFAULT 45000, next_due_at TEXT, max_items INTEGER DEFAULT 5, requires_container INTEGER DEFAULT 0, attempts INTEGER DEFAULT 0);
+CREATE TABLE control_registry (control TEXT PRIMARY KEY, location TEXT NOT NULL, kind TEXT NOT NULL CHECK (kind IN ('hold', 'filter', 'pause', 'kill-switch', 'gate', 'cap', 'guard', 'lease')), guards_against TEXT, critical_path INTEGER NOT NULL DEFAULT 0, disposition TEXT NOT NULL CHECK (disposition IN ('remove', 'demote', 'replace', 'keep')), disposition_state TEXT NOT NULL DEFAULT 'planned' CHECK (disposition_state IN ('planned', 'applied')), alternate_path TEXT, alternate_tested_at TEXT, evidence TEXT NOT NULL, issue_id INTEGER, reviewed_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')));
+CREATE TABLE failure_modes (fm_key TEXT PRIMARY KEY, failure_mode TEXT NOT NULL, root_cause TEXT NOT NULL, remediation TEXT NOT NULL, detector TEXT NOT NULL, probe_class TEXT, first_seen TEXT NOT NULL, issue_id INTEGER, trigger_condition TEXT, symptom TEXT, blast_radius TEXT);
+CREATE TABLE decision_log (id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%SZ', 'now')), actor TEXT NOT NULL, assumption TEXT NOT NULL, action TEXT NOT NULL, evidence TEXT NOT NULL, outcome TEXT NOT NULL, blast_radius TEXT NOT NULL, rollback_path TEXT NOT NULL, capability_gain TEXT, predicted_outcome TEXT, reach_gain TEXT, surfaces_tested TEXT, outcome_matched INTEGER);
+CREATE TRIGGER decision_log_no_delete BEFORE DELETE ON decision_log BEGIN SELECT RAISE(ABORT, 'DOCTRINE-1: decision_log is append-only (doctrine section 12)'); END;
+CREATE TRIGGER decision_log_no_update BEFORE UPDATE ON decision_log BEGIN SELECT RAISE(ABORT, 'DOCTRINE-1: decision_log is append-only (doctrine section 12)'); END;
+CREATE TABLE agent_issues (id INTEGER PRIMARY KEY, status TEXT, title TEXT);
+CREATE TABLE cloud_ops_events (id TEXT PRIMARY KEY, ts TEXT, kind TEXT, text TEXT, meta TEXT, job TEXT, status TEXT);
+CREATE TABLE reach_signals (date TEXT NOT NULL, source TEXT NOT NULL, channel TEXT NOT NULL, entity_type TEXT NOT NULL, entity_id TEXT NOT NULL, metric TEXT NOT NULL, value REAL, quality TEXT, PRIMARY KEY (date, source, channel, entity_type, entity_id, metric));
+CREATE TABLE metric_history (metric TEXT NOT NULL, day TEXT NOT NULL, value REAL, meets INTEGER, target TEXT, ts TEXT, PRIMARY KEY (metric, day));
+CREATE TABLE v_metric_trigger_state (id INTEGER PRIMARY KEY, metric_key TEXT, val REAL, hit INTEGER);`;
+
+// The contracts as they are live (read 2026-10-19: 2040 closed since 2026-10-14 with 14 attempts; 2945 monitoring; 2607, the open issue for
+// trigger 1820, superseded 'contract-on-closed-issue' with 18 attempts), plus a bystander.
+const OLD_2040 = "SELECT '1' AS expected, CASE WHEN (SELECT hit FROM v_metric_trigger_state WHERE id = 1820) = 0 AND (SELECT val FROM v_metric_trigger_state WHERE id = 1820) IS NOT NULL THEN 'recovering' ELSE '0' END AS observed";
+const OLD_2945 = "SELECT '1' AS expected, CASE WHEN (SELECT hit FROM v_metric_trigger_state WHERE id = 370) = 0 AND (SELECT val FROM v_metric_trigger_state WHERE id = 370) IS NOT NULL THEN 'recovering' ELSE '0' END AS observed";
+const OLD_2607 = OLD_2040;
+const T1820 = "METRIC-TRIGGER-1820-EXTERNAL-REFERRED-PAGEVIEWS-7D: Reach gap: fewer than 50 human page loads a week";
+function fresh(opts) {
