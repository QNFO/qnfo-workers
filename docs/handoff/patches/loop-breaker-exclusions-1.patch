+}
+
+// 14. header lines the migration runner needs (scripts/apply_migrations.py --check also runs on the PR)
+{
+  ok(/^-- APPLY-BY: ci$/m.test(sql) && /^-- DB: qnfo-audit$/m.test(sql), "APPLY-BY: ci and DB: qnfo-audit");
+  const code = sql.split("\n").filter((l) => !l.startsWith("--")).join("\n"); // the header's Rollback line also says DROP VIEW
+  ok(/^-- BACKUP: bak_20261019_v_loop_breaker_signatures$/m.test(sql) && /CREATE TABLE IF NOT EXISTS bak_20261019_v_loop_breaker_signatures AS SELECT[^;]*FROM sqlite_master/.test(code)
+    && code.indexOf("CREATE TABLE IF NOT EXISTS bak_20261019_v_loop_breaker_signatures") < code.indexOf("DROP VIEW IF EXISTS v_loop_breaker_signatures"),
