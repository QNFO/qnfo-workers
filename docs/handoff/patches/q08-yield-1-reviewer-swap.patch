+    ins.run("-2 hours", "gate_failed", "unsupported claim", 900, "hn+fulltext");
+    ok(d.prepare(thin).get().observed === "0", "thin-source contract: five ok forecast rows teach no floor (a failed 900-character essay run reads 0, not 1)", d.prepare(thin).get());
+  }
+  {
+    // five ok essay rows (floor 1500), an ok forecast row of 300 and a failed forecast of 200: only the failed 900-character essay run counts
+    const [d, ins] = mk();
+    for (const sc of [1500, 2600, 3000, 2800, 4100]) ins.run("-3 days", "ok", null, sc, "hn+fulltext");
+    ins.run("-3 days", "ok", null, 300, "forecast");
+    ins.run("-2 hours", "gate_failed", "forecast: x", 200, "forecast");
