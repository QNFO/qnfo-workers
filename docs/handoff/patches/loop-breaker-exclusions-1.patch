+}
+
+// 3. the six output columns keep their names and order (scripts/loop_breaker_runner.py and the issue-<id> probes read them)
+{
+  const names = (db) => db.prepare("PRAGMA table_info(v_loop_breaker_signatures)").all().map((c) => c.name);
+  ok(JSON.stringify(names(build(false))) === JSON.stringify(COLS), "base columns", names(build(false)));
+  ok(JSON.stringify(names(build(true))) === JSON.stringify(COLS), "new columns equal the old ones", names(build(true)));
+  const db = build(true, seedAll);
+  const r = db.prepare("SELECT src, producer, sig, n, last_ts, example FROM v_loop_breaker_signatures WHERE sig = ?").get(SIGS.timeout[1]);
+  ok(r && r.n === 3 && /^container_workspace_exec: container timeout after\s+ms$/.test(r.example.replace(/[0-9]/g, "")) && typeof r.last_ts === "string",
+    "a listed row keeps its example and last_ts", r);
+}
+
+// 4. excluded rows do not count towards a signature
+{
+  // cut meta rows share the bare signature 'shell_exec': 3 excluded + 3 unclassified read n=3; 3 excluded + 2 unclassified read nothing
+  const mixed = (genuine) => (db) => {
+    many(db, 3, { text: "shell_exec", meta: cutMeta(CMD_EXIT_QW) });
+    many(db, genuine, { text: "shell_exec", meta: cutMeta("container error: spawn failed"), minAgo: 100 });
+  };
+  const three = rows(build(true, mixed(3)));
+  ok(has(three, SIGS.cut)?.n === 3, "3 excluded + 3 unclassified cut rows read n=3, not 6", three);
+  ok(has(rows(build(false, mixed(3))), SIGS.cut)?.n === 6, "the base counts all 6");
+  ok(!has(rows(build(true, mixed(2))), SIGS.cut), "3 excluded + 2 unclassified cut rows read nothing");
+}
+
+// 5. a pattern in the text column excludes (patterns are matched in meta and text, as tool_failures_24h does)
+{
+  const db = build(true, (d) => many(d, 3, { text: "unknown tool: cf_whatever", meta: "{}" }));
+  ok(rows(db).length === 0, "an ops_ai_tool row whose text matches 'unknown tool' is excluded", rows(db));
+  ok(rows(build(false, (d) => many(d, 3, { text: "unknown tool: cf_whatever", meta: "{}" }))).length === 1, "and is listed on the base");
+}
+
+// 6. a wildcard pattern is a literal here, as in the other consumers: '%no such column%' matches nothing, its plain twin does
+{
+  const db = build(true, (d) => { d.exec("DELETE FROM tool_error_exclusions WHERE pattern = 'no such column'"); many(d, 3, { text: "ops_d1_query", meta: metaOf(NO_COL) }); });
+  ok(has(rows(db), SIGS.col)?.n === 3, "without the plain pattern the wildcard twin excludes nothing", rows(db));
+}
+
+// 7. an empty pattern must not blind the loop breaker (instr(x, '') = 1)
+{
+  const db = build(true, seedAll);
+  const before = rows(db).length;
+  db.exec("INSERT INTO tool_error_exclusions (pattern, err_class) VALUES ('', 'agent-input-error')");
+  ok(rows(db).length === before && before === 5, "an empty exclusion pattern changes nothing", rows(db).length);
+}
+
+// 8. the view follows the table: a pattern added later takes effect at once, a removed one stops
+{
+  const db = build(true, seedAll);
+  ok(has(rows(db), SIGS.timeout), "container timeout is listed");
+  db.exec("INSERT INTO tool_error_exclusions (pattern, err_class) VALUES ('container timeout', 'infra-artifact')");
+  ok(!has(rows(db), SIGS.timeout), "a new 'container timeout' pattern removes it");
+  db.exec("DELETE FROM tool_error_exclusions WHERE pattern = 'container timeout'");
+  ok(has(rows(db), SIGS.timeout), "removing the pattern lists it again");
+  db.exec("DELETE FROM tool_error_exclusions");
+  const none = rows(db);
+  ok(has(none, SIGS.cut)?.n === 6 && has(none, SIGS.cmd)?.n === 4 && has(none, SIGS.cwe)?.n === 4 && has(none, SIGS.col)?.n === 4,
+    "with no exclusion the four signatures come back with the base counts", none.map((r) => [r.sig, r.n]));
+}
+
+// 9. window, 'filed agent_issue' rule, HAVING 3 and the code-task arm are unchanged
+{
+  const seed = (db) => {
+    many(db, 3, { text: "container_workspace_exec", meta: metaOf("container timeout after 60000 ms"), minAgo: 25 * 60 }); // older than 24 h
+    many(db, 3, { kind: "ops-watch", job: "qnfo-ops", text: "filed agent_issue 123: something", meta: "{}" });
+    many(db, 2, { text: "github_file_write", meta: metaOf("GitHub 404: x") });
+    many(db, 3, { text: "cf_worker_read", meta: metaOf("boom"), status: "ok" });
+    const ct = db.prepare("INSERT INTO code_tasks (id, path, status, updated_at, last_error) VALUES (?, ?, ?, ?, ?)");
+    for (let i = 0; i < 3; i++) ct.run("t" + i, "qnfo-x/worker.js", "failed", new Date(NOW - i * 6e4).toISOString(), "read failed: raw read HTTP 404 (HTTP 404)");
+  };
+  const a = rows(build(false, seed)), b = rows(build(true, seed));
+  ok(JSON.stringify(a) === JSON.stringify(b), "old and new views agree when no exclusion applies", { a, b });
+  ok(a.length === 1 && a[0].src === "code-task" && a[0].n === 3, "only the code-task arm lists a row (old window, filed agent_issue, n<3 and ok rows are skipped)", a);
+}
+
+// 10. no ops_ai_tool row: the new view is the old view
+{
+  const seed = (db) => {
+    many(db, 5, { kind: "code-task.fail", job: "qnfo-code-orchestrator", text: "ct_im1 propose: HTTP 500 no such column: x", meta: "{}" });
+    many(db, 3, { kind: "migration-sweep", job: "remediation-consumer", text: "MIGRATION-UNAPPLIED-1: 1 opted-in migration(s) had no run", meta: "{}" });
+  };
+  const a = rows(build(false, seed)), b = rows(build(true, seed));
+  ok(a.length === 2 && JSON.stringify(a) === JSON.stringify(b), "without ops_ai_tool rows both views return the same two rows", { a, b });
+}
+
+// 11. idempotent, and the backup keeps the replaced view
+{
+  const db = build(true, seedAll);
+  const first = rows(db);
+  db.exec(sql);
+  ok(JSON.stringify(rows(db)) === JSON.stringify(first), "a second run changes nothing");
+  let bak = [];
+  try { bak = db.prepare("SELECT name, sql, saved_at FROM bak_20261019_v_loop_breaker_signatures").all(); } catch { /* no backup table: the assertion below fails */ }
+  ok(bak.length === 1 && bak[0].name === "v_loop_breaker_signatures" && bak[0].sql === OLD_VIEW && /^\d{4}-\d\d-\d\dT/.test(bak[0].saved_at),
+    "the backup table holds the old view text once, and a second run does not overwrite it with the new one", bak.map((r) => [r.name, r.sql.length]));
+  const count = (t, w) => db.prepare("SELECT COUNT(*) AS n FROM " + t + " WHERE " + w).get().n;
+  ok(count("control_registry", "control = 'loop-breaker-tool-error-exclusions'") === 1, "one control_registry row");
+  ok(count("failure_modes", "fm_key = 'loop-breaker-ignores-exclusions'") === 1, "one failure_modes row");
+  ok(count("remediation_contracts", "class = 'fm-loop-breaker-ignores-exclusions'") === 1, "one detector contract");
+  ok(count("decision_log", "actor = 'session_01QpQv19uh1padRwZ3u1r766'") === 1, "one decision_log row after two runs");
+  const loc = db.prepare("SELECT location FROM control_registry WHERE control = 'tool_error_exclusions'").get().location;
+  ok(loc === TOOL_EXCLUSIONS_LOCATION.replace("tool_failures_24h)", "tool_failures_24h, v_loop_breaker_signatures)"), "the exclusion table's reader list names the view once", loc);
+}
+
+// 12. the registry rows follow the doctrine
+{
+  const db = build(true);
+  const c = db.prepare("SELECT * FROM control_registry WHERE control = 'loop-breaker-tool-error-exclusions'").get();
+  ok(c && c.kind === "filter" && c.disposition === "keep" && c.disposition_state === "applied" && c.critical_path === 0 && c.issue_id === 100083,
+    "control_registry: a non-critical filter, disposition keep, applied", c);
+  ok(c && /tool_failures_excluded_24h/.test(c.alternate_path) && c.alternate_tested_at && /container timeout/.test(c.alternate_path), "control_registry names its alternate path and when it was read", c);
