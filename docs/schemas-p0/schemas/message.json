{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QNFO chat message payload",
  "type": "object",
  "required": [
    "role",
    "text"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system",
        "function",
        "tool"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}