+    "failure_modes row has root cause, remediation, detector, probe class and the three context columns", f);
+  const k = db.prepare("SELECT * FROM remediation_contracts WHERE class = 'fm-loop-breaker-ignores-exclusions'").get();
+  ok(k && k.verify_transport === "d1-query" && k.status === "active" && k.module === "failure-mode" && k.expected_cadence_h === 1 && k.issue_id === null, "detector contract: d1-query, active, hourly", k);
+  const d = db.prepare("SELECT * FROM decision_log WHERE actor = 'session_01QpQv19uh1padRwZ3u1r766'").get();
