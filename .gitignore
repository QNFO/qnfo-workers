
# wrangler auth cache — never commit
.wrangler/

# Local backup/quarantine artifacts must never be committed (AUDIT-CLUTTER-GATE-1, 2026-09-23)
*.bak
*.bak-*
*.bak.*

# python bytecode (never commit)
__pycache__/
*.pyc

# scripts/deploy_gate.py --check writes wrangler dry-run output to <dir>/<name>/.dryrun-tmp/; never commit it
.dryrun-tmp/

# scripts/ux-journeys/run.mjs --mode local writes its result here; local journey runs must never be committed (PR 11256 merged one)
scripts/ux-journeys/ci-status/ux-journeys-local.json
