+    ok(d.prepare(thin).get().observed === "1", "thin-source contract: the failed essay run below the essay floor reads 1 beside the forecast rows", d.prepare(thin).get());
+  }
+  ok(/COALESCE\(source_kind, ''\) <> 'forecast'/.test(sql.replace(/''/g, "'")) && (sql.match(/<> ''forecast''/g) || []).length >= 3, "the probe filters forecast rows in all three of its subqueries");
